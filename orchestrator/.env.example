# Hotel NEXUS orchestrator — required environment variables.
# Copy to .env for local runs; set as host secrets (Railway/Fly/Render/VPS) for deployment.
# .env itself is gitignored — never commit real values, same rule as everywhere else in this repo.

SUPABASE_URL=
# Service-role key, NOT the anon key — this process runs server-side and needs to bypass
# RLS to read agent_profile/approval_request authoritatively, same trust level as
# supabase/functions/publish-external. Never expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=

# Edge Function URL this process calls for anything leaving the system — same enforcement
# point the browser client uses, per adapters/ruflo.md §3. This process does NOT hold
# Slack/HeyGen secrets directly; those stay in the Edge Function's own secrets.
PUBLISH_EXTERNAL_URL=

# Night shift schedule, cron syntax. Default: 2am daily.
NIGHT_SHIFT_CRON=0 2 * * *
